{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2022", /* Node 22 runs ES2022 natively. */
    "useDefineForClassFields": false, /* Keep v1 class-field semantics (assignment in the constructor). */
    "types": ["node"], /* Only the Node.js globals; untyped dependencies are shimmed in src/missing-types.d.ts. */
    "experimentalDecorators": true, /* Enables experimental support for ES7 decorators. */

    /* Modules */
    "module": "NodeNext", /* ESM output, because package.json has "type": "module". */
    "moduleResolution": "NodeNext",
    "rootDir": "./src",

    /* Emit */
    "outDir": "./dist",
    "declaration": true, /* Generates corresponding '.d.ts' file. */
    "sourceMap": true, /* Generates corresponding '.map' file. */
    "sourceRoot": "./", /* Specify the location where debugger should locate TypeScript files instead of source locations. */
    "inlineSources": true, /* Emit the source alongside the sourcemaps. */
    "removeComments": false, /* Do not emit comments to output. */

    /* Type Checking */
    "strict": true, /* Enable all strict type-checking options. */
    "alwaysStrict": true, /* Parse in strict mode and emit "use strict" for each source file. */
    "noUnusedLocals": true /* Report errors on unused locals. */
  },
  /* Only the library and CLI sources: factory/ and test/ are never compiled. */
  "include": ["src"]
}
