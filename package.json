{
  "name": "syncodemayo",
  "version": "2.0.0",
  "description": "A simple FTP syncing tool",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "syncodemayo": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "test": "bun run compile && node --test \"test/**/*.test.mjs\"",
    "compile": "tsc -p ./tsconfig.json && chmod +x dist/cli.js && echo 'Finished compile.'",
    "compile:watch": "tsc --watch -p ./tsconfig.json",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepublishOnly": "bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattmccray/syncodemayo.git"
  },
  "author": "Matt McCray <matt@elucidata.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mattmccray/syncodemayo/issues"
  },
  "homepage": "https://github.com/mattmccray/syncodemayo#readme",
  "dependencies": {
    "basic-ftp": "^6.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ftp-srv": "^4.6.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.4"
}
