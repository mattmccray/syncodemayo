{
  "name": "syncodemayo",
  "version": "1.0.9",
  "description": "A simple FTP syncing tool",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "syncodemayo": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "test": "npm run compile && node --test \"test/**/*.test.mjs\"",
    "compile": "tsc -p ./tsconfig.json && chmod +x dist/cli.js && echo 'Finished compile.'",
    "compile:watch": "tsc --watch -p ./tsconfig.json",
    "version:bump": "npm version patch",
    "prepublishOnly": "npm run version:bump && npm run compile"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattmccray/syncodemayo.git"
  },
  "author": "Matt McCray <matt@elucidata.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mattmccray/syncodemayo/issues"
  },
  "homepage": "https://github.com/mattmccray/syncodemayo#readme",
  "dependencies": {
    "commander": "^2.11.0",
    "dotenv": "^4.0.0",
    "joi": "^10.6.0",
    "jsftp": "1.3.1",
    "jsftp-mkdirp": "0.1.2",
    "strip-json-comments": "^2.0.1",
    "yesno": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
