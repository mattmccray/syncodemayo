// A config with comments that sets only the required fields.
{
  /* The local side: only the required `path`. */
  "local": {
    "path": "test/fixtures/site" // line comment after a value
  },
  "targets": {
    /*
     * A block comment spanning
     * several lines.
     */
    "staging": {
      "host": "staging.example.com",
      "user": "stage-user",
      "path": "www/stage" // the remote path
    }
  }
}
